# Copy to .env for local development. Never commit .env.
# Only non-secret settings belong here; secrets are Podman/Docker secrets.

# Container engine: podman (default when installed) or docker.
CASSIE_ENGINE=

# Address every published port binds to. Keep 127.0.0.1 unless you have
# put a reverse proxy with TLS and authentication in front of Cassie.
CASSIE_BIND_ADDR=127.0.0.1

# Dev compose project name.
CASSIE_COMPOSE_PROJECT=cassie-dev
